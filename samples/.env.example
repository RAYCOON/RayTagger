# RayTagger — environment variables for online lookup providers.
# Copy to ./.env (gitignored) and fill in.

# --- AcoustID (audio fingerprint → MusicBrainz IDs) ---
# Free key after signup: https://acoustid.org/new-application
ACOUSTID_API_KEY=

# --- Discogs (release styles + genres; especially good for electronic) ---
# Personal access token: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# --- Last.fm (crowd-sourced top tags; noisy but broad) ---
# API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# MusicBrainz needs no key but enforces 1 req/s — Tagger handles that automatically.

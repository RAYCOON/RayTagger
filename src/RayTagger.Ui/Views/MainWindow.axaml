<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RayTagger.Ui.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="RayTagger.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RayTagger"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500">

    <!-- No design-time DataContext: the VM has constructor dependencies that the XAML designer
         can't resolve. The Avalonia previewer renders against an empty DataContext, which is
         fine for layout work. -->

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Name="PickFolderButton" Content="Ordner wählen…"
                        Click="OnPickFolderClick"/>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding Scan.SourceDirectory, FallbackValue='(noch kein Ordner)'}"
                           TextTrimming="CharacterEllipsis"/>
                <Button Content="Scan starten"
                        Command="{Binding Scan.ScanCommand}"
                        IsEnabled="{Binding !Scan.IsBusy}"/>
                <Button Content="Abbrechen"
                        Command="{Binding Scan.CancelCommand}"
                        IsEnabled="{Binding Scan.IsBusy}"/>
                <Button Content="Alle anwenden"
                        Classes="accent"
                        Click="OnApplyAllClick"
                        IsEnabled="{Binding !Scan.IsBusy}"
                        ToolTip.Tip="Schreibt alle 'Würde ändern'-Zeilen auf Disk (mit Backup-Sidecar)."/>
            </StackPanel>
        </Border>

        <!-- Analyzer + lookup status panel: live banner of tool availability. -->
        <Border Grid.Row="1" Padding="12,6"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                IsVisible="{Binding ToolStatus.Entries.Count}">
            <ItemsControl ItemsSource="{Binding ToolStatus.Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2,16,2" Padding="6,2"
                                CornerRadius="4"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Glyph}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Label}"/>
                                <TextBlock Text="{Binding Detail, FallbackValue=''}"
                                           Opacity="0.6"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Results grid -->
        <DataGrid Grid.Row="2" Name="ResultsGrid"
                  ItemsSource="{Binding Scan.Outcomes}"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datei" Width="220" Binding="{Binding FileName}"/>
                <DataGridTextColumn Header="Status" Width="110" Binding="{Binding StatusLabel}"/>
                <DataGridTextColumn Header="Genre (aktuell → neu)" Width="220">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} → {1}">
                            <Binding Path="ExistingGenre" FallbackValue=""/>
                            <Binding Path="ProposedGenre" FallbackValue=""/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Sub-Genre" Width="140" Binding="{Binding ProposedSubGenre, FallbackValue=''}"/>
                <DataGridTextColumn Header="BPM" Width="70" Binding="{Binding ProposedBpm}"/>
                <DataGridTextColumn Header="Key" Width="60" Binding="{Binding ProposedKey}"/>
                <DataGridTextColumn Header="Energy" Width="65" Binding="{Binding ProposedEnergy}"/>
                <DataGridTextColumn Header="Mood" Width="100" Binding="{Binding ProposedMood, FallbackValue=''}"/>
                <DataGridTextColumn Header="Set" Width="100" Binding="{Binding ProposedSetPosition, FallbackValue=''}"/>
                <DataGridTextColumn Header="Regeln" Width="*" Binding="{Binding AppliedRules, Converter={x:Static vm:JoinConverter.Instance}}"/>
                <!-- Per-row Aktion: Apply + Revert side by side. Commands live on
                     ScanViewModel; we reach back via the window's DataContext so a row VM
                     doesn't need to carry the coordinator reference. Each button gates on its
                     own Can* property — Apply only for "Würde ändern" rows, Revert only when a
                     sidecar is present. -->
                <DataGridTemplateColumn Header="Aktion" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Content="Anwenden"
                                        Padding="8,2"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.ApplyRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanApply}"
                                        ToolTip.Tip="{Binding ApplyError, FallbackValue='Schreibt diese Datei auf Disk.'}"/>
                                <Button Content="Revert"
                                        Padding="8,2"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.RevertRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanRevert}"
                                        ToolTip.Tip="Stellt die zuletzt gesicherten Tags aus dem Sidecar wieder her."/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="12,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding Scan.StatusMessage, FallbackValue='Bereit.'}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="{Binding Scan.ScannedCount, StringFormat='{}Gescannt: {0}'}"/>
                    <TextBlock Text="{Binding Scan.ChangedCount, StringFormat='{}Änderungen: {0}'}"/>
                    <TextBlock Text="{Binding Scan.AppliedCount, StringFormat='{}Angewendet: {0}'}"
                               Foreground="{DynamicResource SystemControlSuccessTextForegroundBrush}"/>
                    <TextBlock Text="{Binding Scan.FailedCount, StringFormat='{}Fehler: {0}'}"
                               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RayTagger.Ui.ViewModels"
        xmlns:views="using:RayTagger.Ui.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="RayTagger.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RayTagger"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500">

    <!-- No design-time DataContext: the VM has constructor dependencies that the XAML designer
         can't resolve. The Avalonia previewer renders against an empty DataContext, which is
         fine for layout work. -->

    <TabControl Name="RootTabs" TabStripPlacement="Top" SelectionChanged="OnTabSelectionChanged">

        <!-- =============== Scan + Apply ============================================= -->
        <TabItem Header="Scan-Ergebnisse">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Top toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        Padding="12,8" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Name="PickFolderButton" Content="Ordner wählen…"
                                Click="OnPickFolderClick"/>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Scan.SourceDirectory, FallbackValue='(noch kein Ordner)'}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Content="Scan starten"
                                Command="{Binding Scan.ScanCommand}"
                                IsEnabled="{Binding !Scan.IsBusy}"/>
                        <Button Content="Abbrechen"
                                Command="{Binding Scan.CancelCommand}"
                                IsEnabled="{Binding Scan.IsBusy}"/>
                        <Button Content="Alle anwenden"
                                Classes="accent"
                                Click="OnApplyAllClick"
                                IsEnabled="{Binding !Scan.IsBusy}"
                                ToolTip.Tip="Schreibt alle 'Würde ändern'-Zeilen auf Disk (mit Backup-Sidecar)."/>
                        <Button Content="Filter zurücksetzen"
                                Command="{Binding Scan.Filters.ClearFiltersCommand}"
                                ToolTip.Tip="Löscht alle Spaltenfilter."/>

                        <!-- Separator pushing calibration to the right edge of the toolbar -->
                        <Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="8,4"/>

                        <Button Content="Energie kalibrieren…"
                                Click="OnCalibrateEnergyClick"
                                IsEnabled="{Binding CalibrateEnergyCommand.CanExecute}"
                                ToolTip.Tip="Friert ein Energie-Profil aus dem gewählten Ordner ein. Re-Tagging vorhandener Dateien muss manuell angestoßen werden."/>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding CalibrationStatus, FallbackValue=''}"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Analyzer + lookup status panel -->
                <Border Grid.Row="1" Padding="12,6"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        IsVisible="{Binding ToolStatus.Entries.Count}">
                    <ItemsControl ItemsSource="{Binding ToolStatus.Entries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2,16,2" Padding="6,2"
                                        CornerRadius="4"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Glyph}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Label}"/>
                                        <TextBlock Text="{Binding Detail, FallbackValue=''}"
                                                   Opacity="0.6"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Results grid — bound to FilteredOutcomes so per-column header TextBoxes
                     narrow the visible rows live. The underlying Outcomes collection stays the
                     source of truth (Apply / Revert / Live-Preview keep mutating it directly). -->
                <DataGrid Grid.Row="2" Name="ResultsGrid"
                          ItemsSource="{Binding Scan.FilteredOutcomes}"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Vertical"
                          RowHeight="22"
                          FontSize="6">
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow:nth-child(2n)">
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
                        </Style>
                        <Style Selector="DataGridCell">
                            <Setter Property="Padding" Value="0,1"/>
                        </Style>
                        <!-- Shared style for the inline filter TextBox living in every column
                             header. Kept small so the header row doesn't dominate the grid. -->
                        <Style Selector="TextBox.filter">
                            <Setter Property="Watermark" Value="Filter…"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="3,1"/>
                            <Setter Property="MinHeight" Value="22"/>
                            <Setter Property="Margin" Value="0,2,0,0"/>
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <!-- Status badge: 3-letter pill (OK / CNG / ERR) instead of a full word.
                             The full StatusLabel still shows in the tooltip for screen readers.
                             SortMemberPath uses the full StatusLabel so click-to-sort groups
                             "Fehler"/"Geschrieben"/"Würde ändern" rather than the truncated badge.
                             Header carries an inline filter TextBox (contains-match on the badge,
                             so e.g. "ER" narrows to ERR rows). Same pattern repeats for every
                             filterable column below. -->
                        <DataGridTemplateColumn Width="60" SortMemberPath="StatusLabel">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Status" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Status, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <TextBlock Text="{Binding StatusBadge}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontFamily="Menlo,Consolas,monospace"
                                               FontWeight="SemiBold"
                                               ToolTip.Tip="{Binding StatusLabel}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="200" Binding="{CompiledBinding FileName, DataType=vm:TrackOutcomeViewModel}">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Dateiname" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.FileName, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="180" Binding="{CompiledBinding Title, DataType=vm:TrackOutcomeViewModel}">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Titel" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Title, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="140" Binding="{CompiledBinding Artist, DataType=vm:TrackOutcomeViewModel}">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Interpret" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Artist, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="60" Binding="{CompiledBinding Year, DataType=vm:TrackOutcomeViewModel}">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Jahr" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Year, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!-- Diff-aware columns: Border background lights up yellow when the row's
                             Existing-* and Proposed-* differ, so a Live-Preview edit visually
                             pops the cells it actually changed. The HasXxxDiff flags are recomputed
                             via [NotifyPropertyChangedFor] on every Existing-/Proposed- mutation.
                             SortMemberPath points at Effective* (Proposed ?? Existing) so rows
                             still in Discovery (or with failed analyzer) sort by their visible
                             disk value instead of collapsing as null. -->
                        <DataGridTemplateColumn Width="180" SortMemberPath="EffectiveGenre">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Genre" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Genre, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasGenreDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding GenreDisplay}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" SortMemberPath="EffectiveSubGenre">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="SubGenre" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.SubGenre, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasSubGenreDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding SubGenreDisplay}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="100" SortMemberPath="EffectiveBpm">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="BPM" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Bpm, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasBpmDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <!-- Foreground priority: dark blue when the analyzer's
                                             genre-range fold failed (forced fallback to snap(raw)),
                                             dark red when a snap-to-grid corrected drift like
                                             122.07 → 122, otherwise the theme default. -->
                                        <TextBlock Text="{Binding BpmDisplay}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{x:Static vm:BpmHighlightBrushConverter.Instance}">
                                                    <Binding Path="BpmIsForcedFallback"/>
                                                    <Binding Path="BpmWasSnapped"/>
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="80" SortMemberPath="EffectiveKey">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Key" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Key, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasKeyDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding KeyDisplay}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Camelot Wheel notation (z.B. "11B" für A-Dur, "8A" für A-Moll).
                             Selber Inhalt wie Key, nur andere Schreibweise — beide Spalten
                             leuchten gemeinsam, wenn der Key wechselt. SortMemberPath nutzt
                             den nullengepaddeten Sort-Key (Wheel-Reihenfolge, nicht lexikografisch). -->
                        <DataGridTemplateColumn Width="80" SortMemberPath="EffectiveCamelotSortKey">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Camelot" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.CamelotKey, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasCamelotKeyDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding CamelotKeyDisplay}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="80" SortMemberPath="EffectiveEnergy">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Energy" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Energy, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasEnergyDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding EnergyDisplay}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" SortMemberPath="EffectiveMood">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Mood" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Mood, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasMoodDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding MoodDisplay}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120" SortMemberPath="EffectiveSetPosition">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Set Time" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.SetPosition, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Border Padding="6,0" VerticalAlignment="Stretch"
                                            Background="{Binding HasSetPositionDiff, Converter={x:Static vm:DiffToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding SetPositionDisplay}" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="180" Binding="{CompiledBinding Album, DataType=vm:TrackOutcomeViewModel}">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Album" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Album, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!-- Länge/Größe/Geändert zeigen formatierte Strings ("1:23", "12,4 MB",
                             "21.05.26 14:35"), sortieren aber über die Roh-Properties — sonst
                             käme "10:05" vor "1:23" und "9 MB" vor "10 MB". -->
                        <DataGridTextColumn Width="70" Binding="{CompiledBinding LengthDisplay, DataType=vm:TrackOutcomeViewModel}"
                                            SortMemberPath="LengthSeconds">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Länge" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Length, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="80" Binding="{CompiledBinding SizeDisplay, DataType=vm:TrackOutcomeViewModel}"
                                            SortMemberPath="SizeBytes">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Größe" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Size, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="115" Binding="{CompiledBinding ModifiedDisplay, DataType=vm:TrackOutcomeViewModel}"
                                            SortMemberPath="LastModifiedUtc">
                            <DataGridTextColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Geändert" FontWeight="Bold"/>
                                    <TextBox Classes="filter"
                                             Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.Filters.Modified, Mode=TwoWay}"/>
                                </StackPanel>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <!-- Rule popup: small button per row → modal listing every fired rule.
                             Replaces the previous comma-joined cell that truncated on long chains.
                             Buttons sind nicht sinnvoll sortierbar. -->
                        <DataGridTemplateColumn Header="Regeln" Width="80" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <Button Content="Zeigen"
                                            Padding="6,2"
                                            FontSize="11"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="OnRulesButtonClick"
                                            IsEnabled="{Binding AppliedRules.Count}"
                                            ToolTip.Tip="Zeigt die Regeln, die für diese Datei angewendet wurden."/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Per-row Aktion: Apply + Revert side by side. Buttons sind nicht sortierbar. -->
                        <DataGridTemplateColumn Header="Aktion" Width="200" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:TrackOutcomeViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Button Content="Anwenden"
                                                Padding="8,2"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.ApplyRowCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanApply}"
                                                ToolTip.Tip="{Binding ApplyError, FallbackValue='Schreibt diese Datei auf Disk.'}"/>
                                        <Button Content="Revert"
                                                Padding="8,2"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.RevertRowCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanRevert}"
                                                ToolTip.Tip="Stellt die zuletzt gesicherten Tags aus dem Sidecar wieder her."/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Status bar -->
                <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        Padding="12,6" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Text="{Binding Scan.StatusMessage, FallbackValue='Bereit.'}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="{Binding Scan.ScannedCount, StringFormat='{}Gescannt: {0}'}"/>
                            <TextBlock Text="{Binding Scan.ChangedCount, StringFormat='{}Änderungen: {0}'}"/>
                            <TextBlock Text="{Binding Scan.AppliedCount, StringFormat='{}Angewendet: {0}'}"
                                       Foreground="{DynamicResource SystemControlSuccessTextForegroundBrush}"/>
                            <TextBlock Text="{Binding Scan.FailedCount, StringFormat='{}Fehler: {0}'}"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- =============== Rule Editor ============================================== -->
        <TabItem Header="Regeln" IsSelected="False">
            <!-- DataContext flows from the parent MainWindowViewModel; we hand the embedded
                 RuleEditorViewModel down so the view can bind to it directly. -->
            <views:RuleEditorView DataContext="{Binding RuleEditor}"/>
        </TabItem>

    </TabControl>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RayTagger.Ui.ViewModels"
             xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
             x:Class="RayTagger.Ui.Views.RuleEditorView"
             x:DataType="vm:RuleEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto,150">

        <!-- Toolbar: file actions + status -->
        <Border Grid.Row="0"
                Padding="8,6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Laden…" Click="OnLoadClick"/>
                <Button Content="Speichern"
                        Classes="accent"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Neu laden"
                        Command="{Binding ReloadCommand}"
                        ToolTip.Tip="Liest die Datei erneut von Disk und verwirft ungespeicherte Änderungen."/>
                <TextBlock VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Text="{Binding FilePath, FallbackValue='(keine Datei geladen)'}"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Code editor — AvaloniaEdit. Text two-way sync happens in code-behind because the
             native Text property is a CLR property, not a styled property, and doesn't bind. -->
        <ae:TextEditor Grid.Row="1"
                       Name="Editor"
                       FontFamily="Menlo,Consolas,monospace"
                       FontSize="13"
                       ShowLineNumbers="True"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"/>

        <!-- Status banner — wraps so long error text doesn't blow up the layout. -->
        <Border Grid.Row="2"
                Padding="8,4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        </Border>

        <!-- Error list. Empty when YAML is valid. Click a row to jump to the line — wired in
             the code-behind handler. -->
        <Border Grid.Row="3" Padding="0">
            <DataGrid ItemsSource="{Binding Errors}"
                      CanUserSortColumns="False"
                      CanUserResizeColumns="True"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      RowHeight="24"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="YAML-Pfad"
                                        Width="280"
                                        Binding="{Binding YamlPath}"/>
                    <DataGridTextColumn Header="Fehler"
                                        Width="*"
                                        Binding="{Binding Message}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>raytagger</AssemblyName>
    <RootNamespace>RayTagger.Cli</RootNamespace>
    <Description>Command-line frontend for RayTagger.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RayTagger.Core\RayTagger.Core.csproj" />
    <ProjectReference Include="..\RayTagger.Metadata\RayTagger.Metadata.csproj" />
    <ProjectReference Include="..\RayTagger.Analysis\RayTagger.Analysis.csproj" />
    <ProjectReference Include="..\RayTagger.Lookup\RayTagger.Lookup.csproj" />
  </ItemGroup>

</Project>
